{
  "name": "soloplay",
  "version": "2.0.0",
  "main": "index.ts",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player",
          "@react-native-ml-kit/text-recognition",
          "react-native-nitro-image",
          "react-native-vision-camera-mlkit",
